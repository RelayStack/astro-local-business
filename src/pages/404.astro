---
import Base from "../layouts/Base.astro";
import { site } from "../config";
---
<Base title="Seite nicht gefunden" description="Diese Seite existiert nicht." noindex>
  <section class="section">
    <div class="wrap">
      <h1>404 — Seite nicht gefunden</h1>
      <p class="hero__lede">
        Diese Adresse existiert nicht (mehr). Zurück zur <a href="/">Startseite</a>,
        oder rufen Sie direkt an: <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>.
      </p>
    </div>
  </section>
</Base>
