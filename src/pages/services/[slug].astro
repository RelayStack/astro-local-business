---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../config";
import { localBusiness, service, faqPage, breadcrumbs } from "../../lib/schema";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const schemas = [
  // Emitted here too so the Service node's `provider: {"@id": ...}` reference
  // resolves within the page rather than dangling across documents.
  localBusiness(),
  service({
    name: entry.data.title,
    description: entry.data.description,
    path: `/services/${entry.id}/`,
  }),
  entry.data.faqs.length > 0 ? faqPage(entry.data.faqs) : null,
  breadcrumbs([
    { name: site.name, path: "/" },
    { name: entry.data.title, path: `/services/${entry.id}/` },
  ]),
];
---
<Base
  title={`${entry.data.title} in ${site.address.city}`}
  description={entry.data.description}
  schemas={schemas}
>
  <section class="section">
    <div class="wrap prose">
      <p class="muted" style="font-size:var(--step--1);">
        <a href="/">Start</a> › {entry.data.title}
      </p>
      <h1>{entry.data.title} in {site.address.city}</h1>
      <p class="hero__lede">{entry.data.description}</p>
      {entry.data.from && <p><strong>ab {entry.data.from}</strong></p>}
      <p>
        <a class="btn btn--primary" href={`tel:${site.phone.replace(/\s/g, "")}`}>
          {site.phone} — jetzt anrufen
        </a>
      </p>

      <Content />
    </div>
  </section>

  {
    entry.data.faqs.length > 0 && (
      <section class="section section--surface">
        <div class="wrap">
          <h2>Häufige Fragen zu {entry.data.title}</h2>
          <div class="faq">
            {entry.data.faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <h2>Einsatzgebiet</h2>
      <p class="muted">{site.areaServed.join(" · ")}</p>
    </div>
  </section>
</Base>
