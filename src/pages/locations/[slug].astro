---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../config";
import { localBusiness, breadcrumbs } from "../../lib/schema";

export async function getStaticPaths() {
  const locations = await getCollection("locations");
  return locations.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// The LocalBusiness node carries an `areaServed` override for this city, so the
// page states a service area rather than a second place of business. Two
// competing addresses for one business is a classic local-SEO own goal.
const schemas = [
  localBusiness({
    areaServed: [{ "@type": "City", name: entry.data.city }],
    "@id": `${site.url}/locations/${entry.id}/#business`,
  }),
  breadcrumbs([
    { name: site.name, path: "/" },
    { name: entry.data.city, path: `/locations/${entry.id}/` },
  ]),
];
---
<Base
  title={`${entry.data.title}`}
  description={entry.data.description}
  schemas={schemas}
>
  <section class="section">
    <div class="wrap prose">
      <p class="muted" style="font-size:var(--step--1);">
        <a href="/">Start</a> › {entry.data.city}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="hero__lede">{entry.data.description}</p>
      <p>
        <a class="btn btn--primary" href={`tel:${site.phone.replace(/\s/g, "")}`}>
          {site.phone} — jetzt anrufen
        </a>
      </p>

      <Content />
    </div>
  </section>
</Base>
