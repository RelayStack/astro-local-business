---
import Base from "../layouts/Base.astro";
import { site } from "../config";
import { localBusiness, breadcrumbs } from "../lib/schema";

const schemas = [
  localBusiness(),
  breadcrumbs([
    { name: site.name, path: "/" },
    { name: "Kontakt", path: "/contact/" },
  ]),
];

// Wire this to a form service (Formspree, Web3Forms, a Cloudflare Worker…) by
// setting `formEndpoint` in src/config.ts. Until then the form is a no-op and
// the mailto/phone links below are the working path.
const hasEndpoint = site.formEndpoint.length > 0;
---
<Base
  title="Kontakt"
  description={`Kontaktieren Sie ${site.name} in ${site.address.city}: ${site.phone}. ${site.tagline}.`}
  schemas={schemas}
>
  <section class="section">
    <div class="wrap">
      <h1>Kontakt</h1>
      <p class="hero__lede">
        Notfall? Rufen Sie an — das ist immer der schnellste Weg:
        <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>.
      </p>

      <ul class="facts" style="margin-top:2rem;">
        <div>
          <dt>Telefon</dt>
          <dd><a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a></dd>
        </div>
        <div>
          <dt>E-Mail</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>Adresse</dt>
          <dd>{site.address.street}, {site.address.zip} {site.address.city}</dd>
        </div>
      </ul>

      <h2>Schreiben Sie uns</h2>
      {hasEndpoint ? (
        <form class="form" method="POST" action={site.formEndpoint}>
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="phone">Telefon</label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel" />
          </div>
          <div class="field">
            <label for="message">Ihr Anliegen</label>
            <textarea id="message" name="message" required></textarea>
          </div>
          <button class="btn btn--primary" type="submit">Nachricht senden</button>
        </form>
      ) : (
        <p class="muted">
          Das Formular ist noch nicht verbunden. Rufen Sie an oder schreiben Sie an{" "}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      )}
    </div>
  </section>
</Base>
