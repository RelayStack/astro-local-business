---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { site, absoluteUrl } from "../config";
import { localBusiness, faqPage } from "../lib/schema";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const locations = (await getCollection("locations")).sort((a, b) => a.data.order - b.data.order);

// Answer the questions customers actually phone about. These are the strings
// AI assistants quote back, so keep the answers short and self-contained.
const faqs = [
  {
    q: `Was kostet ein Notdienst-Einsatz in ${site.address.city}?`,
    a: `Wir nennen den Preis vor Beginn der Arbeit. Die Anfahrt innerhalb von ${site.address.city} ist im Pauschalpreis enthalten, es gibt keine Zuschläge für Abende oder Wochenenden.`,
  },
  {
    q: "Wie schnell sind Sie vor Ort?",
    a: `Bei Notfällen in ${site.areaServed.slice(0, 3).join(", ")} sind wir in der Regel innerhalb von 60 Minuten vor Ort.`,
  },
  {
    q: `Arbeiten Sie auch ausserhalb von ${site.address.city}?`,
    a: `Ja. Unser Einsatzgebiet umfasst ${site.areaServed.join(", ")}.`,
  },
];

const schemas = [
  localBusiness(),
  faqPage(faqs),
];
---
<Base title={site.name} description={site.description} schemas={schemas}>
  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow">{site.tagline}</p>
      <h1>
        {site.tagline.split(" in ")[0]} in {site.address.city}
      </h1>
      <p class="hero__lede">
        {site.description}
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={`tel:${site.phone.replace(/\s/g, "")}`}>
          Jetzt anrufen: {site.phone}
        </a>
        <a class="btn btn--ghost" href="/contact/">Angebot anfordern</a>
      </div>
    </div>
  </section>

  <section class="section section--surface" id="leistungen">
    <div class="wrap">
      <h2>Leistungen</h2>
      <p class="muted">Jede Leistung hat eine eigene Seite — damit Sie für genau diese Anfrage gefunden werden.</p>
      <div class="grid">
        {
          services.map((entry) => (
            <article class="card">
              <h3><a href={`/services/${entry.id}/`}>{entry.data.title}</a></h3>
              <p>{entry.data.description}</p>
              {entry.data.from && <p class="card__price">ab {entry.data.from}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="gebiete">
    <div class="wrap">
      <h2>Einsatzgebiet</h2>
      <p class="muted">
        Wir arbeiten in {site.address.city} und der Region. Wählen Sie Ihren Ort für Details:
      </p>
      <div class="grid">
        {
          locations.map((entry) => (
            <article class="card">
              <h3><a href={`/locations/${entry.id}/`}>{entry.data.title}</a></h3>
              <p>{entry.data.description}</p>
            </article>
          ))
        }
      </div>
      {
        locations.length === 0 && (
          <ul>
            {site.areaServed.map((city) => (
              <li>{city}</li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Häufige Fragen</h2>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p style="margin-top:2rem;">
        <a class="btn btn--primary" href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
      </p>
      <p class="muted" style="margin-top:1rem;">
        <a href={absoluteUrl("/llms.txt")}>llms.txt</a> · <a href={absoluteUrl("/sitemap.xml")}>sitemap.xml</a>
      </p>
    </div>
  </section>
</Base>
