---
interface Props {
  schemas?: unknown[];
}
const { schemas = [] } = Astro.props;
// Trim our own JSON.stringify formatting so the output stays compact.
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
---
{
  schemas.filter(Boolean).map((schema) => (
    <script type="application/ld+json" set:html={json(schema)} />
  ))
}
