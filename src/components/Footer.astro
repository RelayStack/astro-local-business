---
import { site } from "../config";
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <strong>{site.name}</strong>
      <address>
        {site.address.street}<br />
        {site.address.zip} {site.address.city}<br />
        <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </div>
    <div>
      <strong>Öffnungszeiten</strong>
      <ul style="list-style:none;padding:0;margin:0.5rem 0 0;">
        {
          site.hours.map((h) => (
            <li>
              {h.days.join(", ")}: {h.opens}–{h.closes}
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <strong>Einsatzgebiet</strong>
      <p class="mt-0" style="margin-top:0.5rem;">{site.areaServed.join(" · ")}</p>
    </div>
  </div>
  <div class="wrap" style="margin-top:2rem;">
    <p class="mt-0">© {year} {site.name}</p>
  </div>
</footer>
